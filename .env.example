APP_MODE=demo
DATABASE_PATH=./data/smart-home.db
DOCKER_BIND_ADDRESS=0.0.0.0
DOCKER_ESP32_TRANSPORT=websocket
# 以下 LLM/VOICE 模型变量仅用于数据库首次初始化；启动后请在控制中心“模型配置”中管理。
LLM_ENABLED=false
LLM_API_KEY=
LLM_ENDPOINT=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
LLM_MAX_COMPLETION_TOKENS=1024
ESP32_ENABLED=true
ESP32_TRANSPORT=auto
ESP32_WS_PATH=/ws/esp32
ESP32_WS_TOKEN=generate-a-random-token-at-least-32-characters
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
ESP32_REQUEST_TIMEOUT_MS=5000
ESP32_HEALTH_STALE_MS=12000
VOICE_ENABLED=false
VOICE_API_KEY=
VOICE_ASR_ENDPOINT=
VOICE_TTS_ENDPOINT=
VOICE_BASE_URL=
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy
VOICE_SAMPLE_RATE=16000
VOICE_VAD_THRESHOLD=700
VOICE_SILENCE_MS=700
VOICE_MIN_SPEECH_MS=400
VOICE_MAX_SPEECH_MS=15000
VOICE_PREFIX_MS=300
