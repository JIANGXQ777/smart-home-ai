{
  "name": "smart-home-ai",
  "version": "2.2.0",
  "description": "面向传统红外家电的 AI 智能化改造系统",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "test": "node --test tests/*.test.js",
    "check": "node backend/check.js && npm test && npm run build",
    "firmware:compile": "arduino-cli compile --fqbn esp32:esp32:esp32s3 --board-options FlashSize=16M,PSRAM=opi,PartitionScheme=app3M_fat9M_16MB,CDCOnBoot=cdc firmware/esp32_ir_bridge",
    "launch": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/start-smart-home-ai.ps1"
  },
  "keywords": [
    "smart-home",
    "ai",
    "iot"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "pinia": "^3.0.4",
    "serialport": "^13.0.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^7.3.6"
  }
}
